{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "auto",

  "packageRules": [
    {
      "automerge": true,
      "autoApprove" : true,
      "labels": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin"]
    },
    {
      "automerge": false,
      "autoApprove" : false,
      "labels": ["major"],
      "matchUpdateTypes": ["major"]
    },
    {
      "enabled": true,
      "autoApprove" : true,
      "automerge": true,
      "labels": ["github_actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
    {
      "enabled": true,
      "autoApprove" : false,
      "automerge": false,
      "labels": ["major"],
      "matchUpdateTypes": ["major"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
  ]
}
